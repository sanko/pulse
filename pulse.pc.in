# pkg-config file for the pulse compiler
# This file is generated by CMake from pulse.pc.in.

prefix=@CMAKE_INSTALL_PREFIX@
exec_prefix=${prefix}
libdir=@CMAKE_INSTALL_FULL_LIBDIR@
includedir=@CMAKE_INSTALL_FULL_INCLUDEDIR@

Name: pulse
Description: A modern scripting language compiler
Version: @PROJECT_VERSION@
URL: https://github.com/sanko/pulse

Libs: -L${libdir} -lpulse
Cflags: -I${includedir}
